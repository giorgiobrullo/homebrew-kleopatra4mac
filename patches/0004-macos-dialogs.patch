+++ b/src/view/infofield.cpp	2026-10-28 15:26:15
@@ -45,6 +45,12 @@
 #endif
     mLayout->addWidget(mValue);
     mButton->setSizePolicy(QSizePolicy::Fixed, QSizePolicy::Fixed);
+#ifdef Q_OS_MACOS
+    // On macOS a horizontal layout takes its top/bottom margins from the layout item rects of
+    // all its widgets, hidden ones included; the (usually hidden) push button's rect would
+    // add 12px to every field, which shows as large gaps where several fields are hidden.
+    mButton->setAttribute(Qt::WA_LayoutUsesWidgetRect);
+#endif
     mButton->setVisible(false);
     mLayout->addWidget(mButton);
     mLayout->addStretch();
diff -ruN a/src/view/tabwidget.cpp b/src/view/tabwidget.cpp
--- a/src/view/tabwidget.cpp	2026-10-28 15:21:53
+++ b/src/view/tabwidget.cpp	2026-10-28 15:27:04

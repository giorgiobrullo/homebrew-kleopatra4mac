     void drawPrimitive(PrimitiveElement element, const QStyleOption *option, QPainter *painter, const QWidget *widget = nullptr) const override
     {
         // AppKit toolbars group items by spacing, not separator lines
         if (element == QStyle::PE_IndicatorToolBarSeparator) {
             return;
+        }
+        // Since Liquid Glass, Qt draws the native rounded text field only if the field's base color
+        // is exactly the system text background; otherwise (e.g. disabled fields) it falls back to a
+        // plain square border. Keep fields with a deliberately custom background as they are.
+        if (element == PE_FrameLineEdit) {
+            const QPalette::ColorGroup group = option->palette.currentColorGroup();
+            if (option->palette.color(group, QPalette::Base) == QApplication::palette().color(group, QPalette::Base)) {
+                if (auto frame = qstyleoption_cast<const QStyleOptionFrame *>(option)) {
+                    QStyleOptionFrame nativeFrame = *frame;
+                    nativeFrame.palette.setColor(group, QPalette::Base, MacSystemColors::textBackground());
+                    QProxyStyle::drawPrimitive(element, &nativeFrame, painter, widget);
+                    return;
+                }
+            }
+        }
+        // the macOS style scales arrows with the space they get; keep them disclosure-sized
+        if (element == PE_IndicatorArrowUp || element == PE_IndicatorArrowDown || element == PE_IndicatorArrowLeft || element == PE_IndicatorArrowRight) {
+            constexpr int maxSize = 10;
+            if (option->rect.width() > maxSize || option->rect.height() > maxSize) {
+                QStyleOption small = *option;
+                small.rect = QRect(0, 0, std::min(option->rect.width(), maxSize), std::min(option->rect.height(), maxSize));
+                small.rect.moveCenter(option->rect.center());
+                QProxyStyle::drawPrimitive(element, &small, painter, widget);
+                return;
+            }
         }
         QProxyStyle::drawPrimitive(element, option, painter, widget);
     }

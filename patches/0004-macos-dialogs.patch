diff -ruN a/src/utils/macsystemcolors.h b/src/utils/macsystemcolors.h
--- a/src/utils/macsystemcolors.h	1970-01-01 01:00:00
+++ b/src/utils/macsystemcolors.h	2026-10-28 15:33:00
@@ -0,0 +1,21 @@
+/*
+    This file is part of Kleopatra, the KDE keymanager
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+class QColor;
+class QPalette;
+
+namespace Kleo::MacSystemColors
+{
+// Points KColorScheme at a color scheme built from the macOS system colors (systemGreen,
+// systemRed, linkColor, the accent color, ...) and the given palette, so that positive /
+// negative highlights and the like match the current light or dark appearance.
+void applyToKColorScheme(const QPalette &palette);
+
+// NSColor.textBackgroundColor for the current appearance
+QColor textBackground();
+}
diff -ruN a/src/utils/macsystemcolors.mm b/src/utils/macsystemcolors.mm
--- a/src/utils/macsystemcolors.mm	1970-01-01 01:00:00
+++ b/src/utils/macsystemcolors.mm	2026-10-28 15:33:00
@@ -0,0 +1,112 @@
+/*
+    This file is part of Kleopatra, the KDE keymanager
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "macsystemcolors.h"
+
+#include <KConfig>
+#include <KConfigGroup>
+
+#include <QApplication>
+#include <QColor>
+#include <QDir>
+#include <QPalette>
+#include <QStandardPaths>
+
+#import <AppKit/AppKit.h>
+
+namespace
+{
+QColor toQColor(NSColor *color)
+{
+    NSColor *rgb = [color colorUsingColorSpace:NSColorSpace.sRGBColorSpace];
+    return QColor::fromRgbF(rgb.redComponent, rgb.greenComponent, rgb.blueComponent, rgb.alphaComponent);
+}
+
+struct SystemColors {
+    QColor positive, negative, neutral, link, visited, accent, inactive;
+};
+
+SystemColors systemColors()
+{
+    __block SystemColors colors;
+    // resolve the dynamic colors for the appearance the application currently uses
+    [NSApp.effectiveAppearance performAsCurrentDrawingAppearance:^{
+        colors.positive = toQColor(NSColor.systemGreenColor);
+        colors.negative = toQColor(NSColor.systemRedColor);
+        colors.neutral = toQColor(NSColor.systemOrangeColor);
+        colors.link = toQColor(NSColor.linkColor);
+        colors.visited = toQColor(NSColor.systemPurpleColor);
+        colors.accent = toQColor(NSColor.controlAccentColor);
+        colors.inactive = toQColor(NSColor.secondaryLabelColor);
+    }];
+    return colors;
+}
+}
+
+QColor Kleo::MacSystemColors::textBackground()
+{
+    __block QColor color;
+    [NSApp.effectiveAppearance performAsCurrentDrawingAppearance:^{
+        color = toQColor(NSColor.textBackgroundColor);
+    }];
+    return color;
+}
+
+void Kleo::MacSystemColors::applyToKColorScheme(const QPalette &palette)
+{
+    if (!NSApp) {
+        return;
+    }
+    const SystemColors system = systemColors();
+
+    struct ColorSet {
+        const char *group;
+        QPalette::ColorRole background;
+        QPalette::ColorRole alternateBackground;
+        QPalette::ColorRole foreground;
+    };
+    static constexpr ColorSet sets[] = {
+        {"Colors:View", QPalette::Base, QPalette::AlternateBase, QPalette::Text},
+        {"Colors:Window", QPalette::Window, QPalette::Window, QPalette::WindowText},
+        {"Colors:Header", QPalette::Window, QPalette::Window, QPalette::WindowText},
+        {"Colors:Button", QPalette::Button, QPalette::Button, QPalette::ButtonText},
+        {"Colors:Selection", QPalette::Highlight, QPalette::Highlight, QPalette::HighlightedText},
+        {"Colors:Tooltip", QPalette::ToolTipBase, QPalette::ToolTipBase, QPalette::ToolTipText},
+    };
+
+    // one file per distinct set of colors, so KColorScheme's cached config is never stale
+    QString signature;
+    for (const QColor &c : {system.positive, system.negative, system.neutral, system.link, system.accent, palette.color(QPalette::Base), palette.color(QPalette::Text)}) {
+        signature += c.name(QColor::HexArgb);
+    }
+    const QString dir = QStandardPaths::writableLocation(QStandardPaths::CacheLocation) + QStringLiteral("/colors");
+    const QString path = QStringLiteral("%1/macos-%2.colors").arg(dir).arg(qHash(signature), 0, 16);
+    if (qApp->property("KDE_COLOR_SCHEME_PATH").toString() == path) {
+        return;
+    }
+    QDir().mkpath(dir);
+
+    KConfig scheme(path, KConfig::SimpleConfig);
+    for (const ColorSet &set : sets) {
+        KConfigGroup group = scheme.group(QLatin1StringView(set.group));
+        group.writeEntry("BackgroundNormal", palette.color(QPalette::Active, set.background));
+        group.writeEntry("BackgroundAlternate", palette.color(QPalette::Active, set.alternateBackground));
+        group.writeEntry("ForegroundNormal", palette.color(QPalette::Active, set.foreground));
+        group.writeEntry("ForegroundInactive", system.inactive);
+        group.writeEntry("ForegroundActive", system.accent);
+        group.writeEntry("ForegroundLink", system.link);
+        group.writeEntry("ForegroundVisited", system.visited);
+        group.writeEntry("ForegroundNegative", system.negative);
+        group.writeEntry("ForegroundNeutral", system.neutral);
+        group.writeEntry("ForegroundPositive", system.positive);
+        group.writeEntry("DecorationFocus", system.accent);
+        group.writeEntry("DecorationHover", system.accent);
+    }
+    scheme.sync();
+
+    // read by KColorScheme's default config (normally set by KColorSchemeManager)
+    qApp->setProperty("KDE_COLOR_SCHEME_PATH", path);
+}

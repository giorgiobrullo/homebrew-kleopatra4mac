diff -ruN a/src/utils/macsymbolicons.mm b/src/utils/macsymbolicons.mm
--- a/src/utils/macsymbolicons.mm	1970-01-01 01:00:00
+++ b/src/utils/macsymbolicons.mm	2026-10-28 15:04:46
@@ -0,0 +1,202 @@
+/*
+    This file is part of Kleopatra, the KDE keymanager
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "macsymbolicons.h"
+
+#include <QAction>
+#include <QGuiApplication>
+#include <QHash>
+#include <QIconEngine>
+#include <QImage>
+#include <QPainter>
+#include <QPalette>
+#include <QPixmap>
+#include <QPixmapCache>
+
+#include <algorithm>
+
+#import <AppKit/AppKit.h>
+
+namespace
+{
+const QHash<QString, QString> &symbolForIconName()
+{
+    static const QHash<QString, QString> map = {
+        {QStringLiteral("document-edit-sign-encrypt"), QStringLiteral("lock.doc")},
+        {QStringLiteral("document-edit-decrypt-verify"), QStringLiteral("lock.open")},
+        {QStringLiteral("view-certificate-import"), QStringLiteral("square.and.arrow.down")},
+        {QStringLiteral("view-certificate-export"), QStringLiteral("square.and.arrow.up")},
+        {QStringLiteral("view-certificate-sign"), QStringLiteral("checkmark.seal")},
+        {QStringLiteral("edit-find"), QStringLiteral("magnifyingglass")},
+        {QStringLiteral("note"), QStringLiteral("note.text")},
+        {QStringLiteral("auth-sim-locked"), QStringLiteral("creditcard")},
+        {QStringLiteral("group"), QStringLiteral("person.2")},
+        {QStringLiteral("tab-new-background"), QStringLiteral("plus")},
+        {QStringLiteral("tab-close"), QStringLiteral("xmark")},
+        {QStringLiteral("edit-undo"), QStringLiteral("arrow.uturn.backward")},
+        {QStringLiteral("view-refresh"), QStringLiteral("arrow.clockwise")},
+        {QStringLiteral("edit-delete"), QStringLiteral("trash")},
+        {QStringLiteral("resource-group-new"), QStringLiteral("person.badge.plus")},
+        {QStringLiteral("document-open"), QStringLiteral("folder")},
+        {QStringLiteral("help-contextual"), QStringLiteral("info.circle")},
+    };
+    return map;
+}
+
+bool symbolExists(const QString &symbol)
+{
+    @autoreleasepool {
+        return [NSImage imageWithSystemSymbolName:symbol.toNSString() accessibilityDescription:nil] != nil;
+    }
+}
+
+QColor tintColor(QIcon::Mode mode)
+{
+    const QPalette pal = QGuiApplication::palette();
+    switch (mode) {
+    case QIcon::Disabled:
+        return pal.color(QPalette::Disabled, QPalette::WindowText);
+    case QIcon::Selected:
+        return pal.color(QPalette::Active, QPalette::HighlightedText);
+    default:
+        return pal.color(QPalette::Active, QPalette::WindowText);
+    }
+}
+
+// Draws an SF Symbol, tinted with the current palette so it follows light/dark mode
+class SymbolIconEngine : public QIconEngine
+{
+public:
+    explicit SymbolIconEngine(const QString &symbol)
+        : m_symbol(symbol)
+    {
+    }
+
+    QIconEngine *clone() const override
+    {
+        return new SymbolIconEngine(m_symbol);
+    }
+
+    QString key() const override
+    {
+        return QStringLiteral("KleoSymbolIconEngine");
+    }
+
+    QString iconName() override
+    {
+        return m_symbol;
+    }
+
+    QSize actualSize(const QSize &size, QIcon::Mode, QIcon::State) override
+    {
+        return size;
+    }
+
+    QList<QSize> availableSizes(QIcon::Mode, QIcon::State) override
+    {
+        return {{16, 16}, {22, 22}, {32, 32}, {48, 48}, {64, 64}};
+    }
+
+    QPixmap pixmap(const QSize &size, QIcon::Mode mode, QIcon::State state) override
+    {
+        return scaledPixmap(size, mode, state, 1.0);
+    }
+
+    void paint(QPainter *painter, const QRect &rect, QIcon::Mode mode, QIcon::State state) override
+    {
+        const qreal scale = painter->device() ? painter->device()->devicePixelRatio() : 1.0;
+        painter->drawPixmap(rect, scaledPixmap(rect.size(), mode, state, scale));
+    }
+
+    QPixmap scaledPixmap(const QSize &size, QIcon::Mode mode, QIcon::State, qreal scale) override
+    {
+        const QColor color = tintColor(mode);
+        const QString cacheKey = QStringLiteral("kleo-sf-%1-%2x%3@%4-%5")
+                                     .arg(m_symbol)
+                                     .arg(size.width())
+                                     .arg(size.height())
+                                     .arg(scale)
+                                     .arg(color.rgba(), 0, 16);
+        QPixmap pixmap;
+        if (QPixmapCache::find(cacheKey, &pixmap)) {
+            return pixmap;
+        }
+
+        const int width = qRound(size.width() * scale);
+        const int height = qRound(size.height() * scale);
+        if (width <= 0 || height <= 0) {
+            return {};
+        }
+        QImage image(width, height, QImage::Format_ARGB32_Premultiplied);
+        image.fill(Qt::transparent);
+
+        @autoreleasepool {
+            NSImage *symbol = [NSImage imageWithSystemSymbolName:m_symbol.toNSString() accessibilityDescription:nil];
+            NSImageSymbolConfiguration *config = [NSImageSymbolConfiguration configurationWithPointSize:size.height() * 0.7
+                                                                                                 weight:NSFontWeightRegular
+                                                                                                  scale:NSImageSymbolScaleMedium];
+            symbol = [symbol imageWithSymbolConfiguration:config];
+            if (symbol) {
+                // fit into the requested size, keeping the symbol's aspect ratio
+                const NSSize natural = symbol.size;
+                const CGFloat fit = std::min(width * 0.9 / natural.width, height * 0.9 / natural.height);
+                const NSSize drawn = NSMakeSize(natural.width * fit, natural.height * fit);
+
+                CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+                CGContextRef context = CGBitmapContextCreate(image.bits(),
+                                                             width,
+                                                             height,
+                                                             8,
+                                                             image.bytesPerLine(),
+                                                             colorSpace,
+                                                             kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Host);
+                [NSGraphicsContext saveGraphicsState];
+                NSGraphicsContext.currentContext = [NSGraphicsContext graphicsContextWithCGContext:context flipped:NO];
+                [symbol drawInRect:NSMakeRect((width - drawn.width) / 2, (height - drawn.height) / 2, drawn.width, drawn.height)
+                          fromRect:NSZeroRect
+                         operation:NSCompositingOperationSourceOver
+                          fraction:1.0];
+                [NSGraphicsContext restoreGraphicsState];
+                CGContextRelease(context);
+                CGColorSpaceRelease(colorSpace);
+            }
+        }
+
+        QPainter painter(&image);
+        painter.setCompositionMode(QPainter::CompositionMode_SourceIn);
+        painter.fillRect(image.rect(), color);
+        painter.end();
+
+        pixmap = QPixmap::fromImage(image);
+        pixmap.setDevicePixelRatio(scale);
+        QPixmapCache::insert(cacheKey, pixmap);
+        return pixmap;
+    }
+
+private:
+    QString m_symbol;
+};
+}
+
+QIcon Kleo::MacSymbolIcons::icon(const QString &iconName)
+{
+    const auto &map = symbolForIconName();
+    const auto it = map.constFind(iconName);
+    if (it == map.cend() || !symbolExists(*it)) {
+        return {};
+    }
+    return QIcon(new SymbolIconEngine(*it));
+}
+
+void Kleo::MacSymbolIcons::apply(const QList<QAction *> &actions)
+{
+    for (QAction *action : actions) {
+        const QIcon symbol = icon(action->icon().name());
+        if (!symbol.isNull()) {
+            action->setIcon(symbol);
+        }
+    }
+}

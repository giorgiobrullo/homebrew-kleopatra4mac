+#ifdef Q_OS_MACOS
+// small labels like AppKit toolbars, and AppKit's toolbar menu instead of KDE's
+// (text position, icon size, position locking)
+void MainWindow::Private::setUpToolBarsForMacOS()
+{
+    const auto toolBars = q->toolBars();
+    for (KToolBar *bar : toolBars) {
+        QFont labelFont = bar->font();
+        labelFont.setPointSizeF(11);
+        bar->setFont(labelFont);
+        // AppKit's toolbar menu instead of KDE's (text position, icon size, position locking)
+        if (bar->contextMenuPolicy() == Qt::CustomContextMenu) {
+            continue; // set up already (the GUI is rebuilt after customizing the toolbar)
+        }
+        bar->setContextMenuPolicy(Qt::CustomContextMenu);
+        connect(bar, &QWidget::customContextMenuRequested, q, [this, bar](const QPoint &pos) {
+            QMenu menu;
+            auto styles = new QActionGroup(&menu);
+            const std::pair<QString, Qt::ToolButtonStyle> choices[] = {
+                {i18nc("@action:inmenu toolbar style", "Icon and Text"), Qt::ToolButtonTextUnderIcon},
+                {i18nc("@action:inmenu toolbar style", "Icon Only"), Qt::ToolButtonIconOnly},
+                {i18nc("@action:inmenu toolbar style", "Text Only"), Qt::ToolButtonTextOnly},
+            };
+            for (const auto &[text, style] : choices) {
+                QAction *action = menu.addAction(text, bar, [bar, style]() {
+                    bar->setToolButtonStyle(style);
+                });
+                action->setCheckable(true);
+                action->setChecked(bar->toolButtonStyle() == style);
+                styles->addAction(action);
+            }
+            if (QAction *customize = q->actionCollection()->action(QStringLiteral("options_configure_toolbars"))) {
+                menu.addSeparator();
+                menu.addAction(customize);
+            }
+            menu.exec(bar->mapToGlobal(pos));
+        });
+    }
+}
+
+// macOS has no Settings menu: the toolbar items belong to the View menu, the remaining settings
+// to the application menu (next to Settings…, which Qt moves there already); the help menu
+// has its own search, and KDE's About entry has no place in a macOS application
+void MainWindow::Private::adaptMenusToMacOS()
+{
+    KActionCollection *const coll = q->actionCollection();
+    // Qt guesses application menu roles from the text, so e.g. View > "Configure sorting" was
+    // taken for the Settings item; KDE sets explicit roles for the standard actions anyway
+    std::function<void(QMenu *)> disableRoleHeuristic = [&](QMenu *menu) {
+        const auto actions = menu->actions();
+        for (QAction *action : actions) {
+            if (action->menuRole() == QAction::TextHeuristicRole) {
+                action->setMenuRole(QAction::NoRole);
+            }
+            if (action->menu()) {
+                disableRoleHeuristic(action->menu());
+            }
+        }
+    };
+    const auto topLevelMenus = q->menuBar()->actions();
+    for (QAction *action : topLevelMenus) {
+        if (action->menu()) {
+            disableRoleHeuristic(action->menu());
+        }
+    }
+    for (const char *name : {"options_configure_keybinding", "switch_application_language"}) {
+        if (QAction *action = coll->action(QLatin1StringView(name))) {
+            action->setMenuRole(QAction::ApplicationSpecificRole);
+        }
+    }
+    for (const char *name : {"help_about_kde", "open_kcommand_bar"}) {
+        if (QAction *action = coll->action(QLatin1StringView(name))) {
+            action->setVisible(false);
+        }
+    }
+    if (QAction *action = coll->action(QStringLiteral("options_configure_toolbars"))) {
+        action->setText(i18nc("@action:inmenu macOS wording", "Customize Toolbar…"));
+    }
+    // Settings… is Cmd+, on macOS (KDE's default is Ctrl+Shift+,); keep a shortcut the user chose
+    if (QAction *action = coll->action(QStringLiteral("options_configure"))) {
+        const QKeySequence kdeDefault(Qt::CTRL | Qt::SHIFT | Qt::Key_Comma);
+        const QKeySequence macDefault(Qt::CTRL | Qt::Key_Comma);
+        coll->setDefaultShortcut(action, macDefault);
+        if (action->shortcut() == kdeDefault) {
+            action->setShortcut(macDefault);
+        }
+    }
+
+    QMenu *viewMenu = nullptr;
+    QMenu *settingsMenu = nullptr;
+    const auto menuBarActions = q->menuBar()->actions();
+    for (QAction *action : menuBarActions) {
+        if (QMenu *menu = action->menu()) {
+            if (menu->objectName() == QLatin1StringView("_view")) {
+                viewMenu = menu;
+            } else if (menu->objectName() == QLatin1StringView("settings")) {
+                settingsMenu = menu;
+            }
+        }
+    }
+    if (!viewMenu || !settingsMenu) {
+        return;
+    }
+    // the items that Qt merges into the application menu have to stay in some menu of the menu bar
+    viewMenu->addSeparator();
+    const auto settingsActions = settingsMenu->actions();
+    for (QAction *action : settingsActions) {
+        settingsMenu->removeAction(action);
+        if (!action->isSeparator()) {
+            viewMenu->addAction(action);
+        }
+    }
+    settingsMenu->menuAction()->setVisible(false);
+}
+#endif
 

+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "macaboutpanel.h"
+
+#include <KAboutData>
+
+#include <QTextDocument>
+#include <QTextDocumentFragment>
+
+#import <AppKit/AppKit.h>
+
+namespace
+{
+QString plainText(const QString &maybeRichText)
+{
+    if (!Qt::mightBeRichText(maybeRichText)) {
+        return maybeRichText.trimmed();
+    }
+    return QTextDocumentFragment::fromHtml(maybeRichText).toPlainText().trimmed();
+}
+}
+
+void Kleo::MacAboutPanel::show(const KAboutData &aboutData)
+{
+    QStringList paragraphs = {aboutData.shortDescription()};
+    if (const QString other = plainText(aboutData.otherText()); !other.isEmpty()) {
+        paragraphs << other;
+    }
+    if (!aboutData.licenses().isEmpty()) {
+        paragraphs << aboutData.licenses().constFirst().name(KAboutLicense::FullName);
+    }
+
+    // label colors are dynamic, so the credits follow light and dark mode
+    NSDictionary *textAttributes = @{
+        NSFontAttributeName: [NSFont systemFontOfSize:NSFont.smallSystemFontSize],
+        NSForegroundColorAttributeName: NSColor.secondaryLabelColor,
+    };
+    NSMutableAttributedString *credits =
+        [[[NSMutableAttributedString alloc] initWithString:paragraphs.join(QStringLiteral("\n\n")).toNSString() attributes:textAttributes] autorelease];
+    const auto appendText = [&](const QString &text) {
+        [credits appendAttributedString:[[[NSAttributedString alloc] initWithString:text.toNSString() attributes:textAttributes] autorelease]];
+    };
+    const auto appendLink = [&](const QString &url, const QString &label) {
+        NSDictionary *linkAttributes = @{
+            NSFontAttributeName: [NSFont systemFontOfSize:NSFont.smallSystemFontSize],
+            NSLinkAttributeName: [NSURL URLWithString:url.toNSString()],
+        };
+        [credits appendAttributedString:[[[NSAttributedString alloc] initWithString:label.toNSString() attributes:linkAttributes] autorelease]];
+    };
+    if (!aboutData.homepage().isEmpty()) {
+        appendText(QStringLiteral("\n\n"));
+        appendLink(aboutData.homepage(), aboutData.homepage());
+    }
+    // where this macOS build comes from, and the project it builds on
+    appendText(QStringLiteral("\n\nmacOS build:\n"));
+    appendLink(QStringLiteral("https://github.com/giorgiobrullo/homebrew-kleopatra4mac"), QStringLiteral("giorgiobrullo/homebrew-kleopatra4mac"));
+    appendText(QStringLiteral("\nbased on kleopatra4mac by "));
+    appendLink(QStringLiteral("https://github.com/algertc/homebrew-kleopatra4mac"), QStringLiteral("algertc"));
+    NSMutableParagraphStyle *centered = [[[NSMutableParagraphStyle alloc] init] autorelease];
+    centered.alignment = NSTextAlignmentCenter;
+    [credits addAttribute:NSParagraphStyleAttributeName value:centered range:NSMakeRange(0, credits.length)];
+
+    [NSApp orderFrontStandardAboutPanelWithOptions:@{
+        NSAboutPanelOptionApplicationName: aboutData.displayName().toNSString(),
+        NSAboutPanelOptionApplicationVersion: aboutData.version().toNSString(),
+        NSAboutPanelOptionVersion: @"",
+        @"Copyright": plainText(aboutData.copyrightStatement()).toNSString(),
+        NSAboutPanelOptionCredits: credits,
+    }];
+}

+#ifdef Q_OS_MACOS
+// Qt still labels the application menu's settings item "Preferences...", which macOS calls
+// "Settings…" since macOS 13. Qt consults this context only if it has no translation of its own.
+class MacApplicationMenuTranslator : public QTranslator
+{
+public:
+    using QTranslator::QTranslator;
+
+    QString translate(const char *context, const char *sourceText, const char *, int) const override
+    {
+        if (qstrcmp(context, "MAC_APPLICATION_MENU") == 0 && qstrcmp(sourceText, "Preferences...") == 0) {
+            return QStringLiteral("Settings…");
+        }
+        return {};
+    }
+
+    bool isEmpty() const override
+    {
+        return false;
+    }
+};
+#endif
+
+#ifdef Q_OS_MACOS
+// tool buttons with a visible label outside of toolbars (e.g. the "Add" button with a menu in
+// the directory services settings) get an old square bezel from Qt's macOS style; AppKit has
+// push buttons (pull-down buttons if there is a menu) for this
+static bool isLabelledToolButton(const QWidget *widget, const QStyleOptionToolButton *option)
+{
+    return qobject_cast<const QToolButton *>(widget) && option && !qobject_cast<const QToolBar *>(widget->parentWidget()) && !option->text.isEmpty()
+        && (option->toolButtonStyle != Qt::ToolButtonIconOnly || option->icon.isNull());
+}
+
+static QStyleOptionButton pushButtonOption(const QStyleOptionToolButton &toolButton)
+{
+    QStyleOptionButton button;
+    button.QStyleOption::operator=(toolButton);
+    button.text = toolButton.text;
+    button.features = QStyleOptionButton::None;
+    if (toolButton.features & (QStyleOptionToolButton::HasMenu | QStyleOptionToolButton::MenuButtonPopup)) {
+        button.features |= QStyleOptionButton::HasMenu;
+    }
+    if (toolButton.state & (QStyle::State_Sunken | QStyle::State_On)) {
+        button.state |= QStyle::State_Sunken;
+    }
+    return button;
+}
+#endif

+static QAction *chosenAction = nullptr;
+
+@interface KleoNativeMenuTarget : NSObject
+@property(nonatomic, assign) QAction *action;
+- (void)activate:(id)sender;
+@end
+
+@implementation KleoNativeMenuTarget
+- (void)activate:(id)sender
+{
+    Q_UNUSED(sender);
+    chosenAction = self.action;
+}
+@end
+
+namespace
+{
+bool isNativeCompatible(QMenu *menu)
+{
+    const auto actions = menu->actions();
+    for (QAction *action : actions) {
+        if (qobject_cast<QWidgetAction *>(action) || (action->menu() && !isNativeCompatible(action->menu()))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+NSString *menuTitle(const QAction *action)
+{
+    QString text = action->text();
+    text.replace(QStringLiteral("&&"), QStringLiteral("\u0001")).remove(QLatin1Char('&')).replace(QChar(1), QLatin1Char('&'));
+    return text.toNSString();
+}
+
+void setKeyEquivalent(NSMenuItem *item, const QKeySequence &shortcut)
+{
+    if (shortcut.isEmpty()) {
+        return;
+    }
+    const QKeyCombination combination = shortcut[0];
+    const int key = combination.key();
+    if (key < 0x20 || key > 0x7e) {
+        return; // only printable keys; the shortcut still works, it is just not displayed
+    }
+    item.keyEquivalent = QString(QChar(key)).toLower().toNSString();
+    NSEventModifierFlags flags = 0;
+    const Qt::KeyboardModifiers modifiers = combination.keyboardModifiers();
+    if (modifiers & Qt::ControlModifier) {
+        flags |= NSEventModifierFlagCommand; // Qt maps Cmd to Ctrl on macOS
+    }
+    if (modifiers & Qt::MetaModifier) {
+        flags |= NSEventModifierFlagControl;
+    }
+    if (modifiers & Qt::AltModifier) {
+        flags |= NSEventModifierFlagOption;
+    }
+    if (modifiers & Qt::ShiftModifier) {
+        flags |= NSEventModifierFlagShift;
+    }
+    item.keyEquivalentModifierMask = flags;
+}
+
+NSMenu *buildMenu(QMenu *menu)
+{
+    NSMenu *nsMenu = [[[NSMenu alloc] initWithTitle:@""] autorelease];
+    nsMenu.autoenablesItems = NO;
+    const auto actions = menu->actions();
+    bool pendingSeparator = false;
+    for (QAction *action : actions) {
+        if (!action->isVisible()) {
+            continue;
+        }
+        if (action->isSeparator()) {
+            pendingSeparator = nsMenu.numberOfItems > 0;
+            continue;
+        }
+        if (pendingSeparator) {
+            [nsMenu addItem:[NSMenuItem separatorItem]];
+            pendingSeparator = false;
+        }
+        NSMenuItem *item = [[[NSMenuItem alloc] initWithTitle:menuTitle(action) action:nil keyEquivalent:@""] autorelease];
+        item.enabled = action->isEnabled();
+        item.state = action->isChecked() ? NSControlStateValueOn : NSControlStateValueOff;
+        // SF Symbol icons (see MacSymbolIcons) as template images, so they follow the highlight;
+        // AppKit shows bitmap images in menus where it leaves out system symbol images
+        if (action->isIconVisibleInMenu() && !action->icon().isNull()
+            && [NSImage imageWithSystemSymbolName:action->icon().name().toNSString() accessibilityDescription:nil]) {
+            const QImage image = action->icon().pixmap(QSize(16, 16), 2.0).toImage();
+            if (CGImageRef cgImage = image.toCGImage()) {
+                NSImage *nsImage = [[[NSImage alloc] initWithCGImage:cgImage size:NSMakeSize(16, 16)] autorelease];
+                [nsImage setTemplate:YES];
+                item.image = nsImage;
+                CGImageRelease(cgImage);
+            }
+        }
+        if (QMenu *subMenu = action->menu()) {
+            Q_EMIT subMenu->aboutToShow(); // populates menus that are filled on demand
+            item.submenu = buildMenu(subMenu);
+        } else {
+            KleoNativeMenuTarget *target = [[[KleoNativeMenuTarget alloc] init] autorelease];
+            target.action = action;
+            item.target = target;
+            item.representedObject = target; // keeps the target alive
+            item.action = @selector(activate:);
+            setKeyEquivalent(item, action->shortcut());
+        }
+        [nsMenu addItem:item];
+    }
+    return nsMenu;
+}
+
+void showNatively(QPointer<QMenu> menu)
+{
+    if (!menu || !menu->isVisible()) {
+        return;
+    }
+    // where Qt placed the menu, in Cocoa's screen coordinates (origin at the bottom left)
+    const QPoint topLeft = menu->geometry().topLeft();
+    const CGFloat primaryHeight = NSScreen.screens.firstObject.frame.size.height;
+
+    chosenAction = nullptr;
+    @autoreleasepool {
+        NSMenu *nsMenu = buildMenu(menu);
+        [nsMenu popUpMenuPositioningItem:nil atLocation:NSMakePoint(topLeft.x(), primaryHeight - topLeft.y()) inView:nil];
+    }
+    QAction *action = chosenAction;
+    chosenAction = nullptr;
+    if (!menu) {
+        return;
+    }
+    if (action && menu->actions().contains(action)) {
+        // let the QMenu activate the item itself, so that exec() returns it
+        menu->setActiveAction(action);
+        QKeyEvent press(QEvent::KeyPress, Qt::Key_Return, Qt::NoModifier);
+        QApplication::sendEvent(menu, &press);
+    } else {
+        menu->close();
+        if (action) {
+            action->trigger(); // chosen in a submenu
+        }
+    }
+}
+
+class PopupMenuFilter : public QObject
+{
+public:
+    using QObject::QObject;
+
+    bool eventFilter(QObject *obj, QEvent *event) override
+    {
+        if (event->type() == QEvent::Show) {
+            auto menu = qobject_cast<QMenu *>(obj);
+            // menus of the menu bar are native already; submenus are part of their native parent
+            if (menu && menu->isWindow() && !qobject_cast<QMenu *>(menu->parentWidget()) && !qobject_cast<QMenuBar *>(menu->parentWidget())
+                && isNativeCompatible(menu)) {
+                menu->setWindowOpacity(0.0); // the Qt menu keeps running, invisibly
+                QTimer::singleShot(0, menu, [menu = QPointer<QMenu>(menu)]() {
+                    showNatively(menu);
+                    if (menu) {
+                        menu->setWindowOpacity(1.0);
+                    }
+                });
+            }
+        }
+        return false;
+    }
+};
+}
+
+void Kleo::MacNativeMenus::install(QApplication *app)
+{
+    app->installEventFilter(new PopupMenuFilter(app));
+}

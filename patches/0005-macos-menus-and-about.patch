diff -ruN a5/src/utils/mactoolbareditor.cpp b5/src/utils/mactoolbareditor.cpp
--- a5/src/utils/mactoolbareditor.cpp	1970-01-01 01:00:00
+++ b5/src/utils/mactoolbareditor.cpp	2026-10-28 16:57:20
@@ -0,0 +1,306 @@
+/*
+    This file is part of Kleopatra, the KDE keymanager
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "mactoolbareditor.h"
+
+#include "macsymbolicons.h"
+
+#include <KActionCollection>
+#include <KLocalizedString>
+#include <KToolBar>
+#include <KXMLGUIFactory>
+#include <KXmlGuiWindow>
+
+#include <QComboBox>
+#include <QDialog>
+#include <QDialogButtonBox>
+#include <QDomDocument>
+#include <QDropEvent>
+#include <QFile>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QListWidget>
+#include <QMenu>
+#include <QPushButton>
+#include <QStyle>
+#include <QVBoxLayout>
+
+using namespace Kleo;
+
+namespace
+{
+const QString separatorName = QStringLiteral("separator");
+
+QString plainText(QString text)
+{
+    return text.replace(QStringLiteral("&&"), QStringLiteral("\u0001")).remove(QLatin1Char('&')).replace(QChar(1), QLatin1Char('&'));
+}
+
+QListWidgetItem *createItem(const QString &name, KActionCollection *collection)
+{
+    if (name == separatorName) {
+        // AppKit shows the toolbar space as a dashed box
+        auto item = new QListWidgetItem(MacSymbolIcons::icon(QStringLiteral("toolbar-space")), i18nc("@item toolbar item that adds a gap", "Space"));
+        item->setData(Qt::UserRole, separatorName);
+        return item;
+    }
+    const QAction *action = collection->action(name);
+    if (!action) {
+        return nullptr;
+    }
+    auto item = new QListWidgetItem(action->icon(), plainText(action->iconText().isEmpty() ? action->text() : action->iconText()));
+    item->setData(Qt::UserRole, name);
+    item->setToolTip(plainText(action->text()));
+    return item;
+}
+
+void setUpIconGrid(QListWidget *list)
+{
+    list->setViewMode(QListView::IconMode);
+    list->setMovement(QListView::Static); // drops reorder instead of placing freely
+    list->setIconSize(QSize(24, 24));
+    list->setGridSize(QSize(104, 64));
+    list->setWordWrap(true);
+    list->setSelectionMode(QAbstractItemView::SingleSelection);
+    list->setDragEnabled(true);
+    list->setAcceptDrops(true);
+    list->setDropIndicatorShown(true);
+    list->setDragDropMode(QAbstractItemView::DragDrop);
+}
+
+// the items currently in the toolbar; dragging reorders them
+class ToolBarStrip : public QListWidget
+{
+public:
+    explicit ToolBarStrip(QWidget *parent)
+        : QListWidget(parent)
+    {
+        setUpIconGrid(this);
+        setFlow(QListView::LeftToRight);
+        setWrapping(false);
+        setDefaultDropAction(Qt::MoveAction);
+        setVerticalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+        setFixedHeight(gridSize().height() + 2 * frameWidth() + style()->pixelMetric(QStyle::PM_ScrollBarExtent) + 8);
+    }
+
+    bool contains(const QString &name) const
+    {
+        for (int row = 0; row < count(); ++row) {
+            if (item(row)->data(Qt::UserRole).toString() == name) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+protected:
+    void dropEvent(QDropEvent *event) override
+    {
+        // an item from the palette that is already in the toolbar is not added twice
+        if (auto palette = qobject_cast<QListWidget *>(event->source()); palette && palette != this) {
+            const auto selected = palette->selectedItems();
+            const QString name = selected.isEmpty() ? QString() : selected.constFirst()->data(Qt::UserRole).toString();
+            if (name != separatorName && contains(name)) {
+                event->ignore();
+                return;
+            }
+        }
+        QListWidget::dropEvent(event);
+    }
+};
+
+// all items that can be put into the toolbar; dropping a toolbar item here removes it
+class Palette : public QListWidget
+{
+public:
+    Palette(QWidget *parent, ToolBarStrip *strip)
+        : QListWidget(parent)
+        , mStrip(strip)
+    {
+        setUpIconGrid(this);
+        setWrapping(true);
+        setResizeMode(QListView::Adjust);
+    }
+
+protected:
+    void startDrag(Qt::DropActions) override
+    {
+        QListWidget::startDrag(Qt::CopyAction); // the palette keeps its items
+    }
+
+    void dragEnterEvent(QDragEnterEvent *event) override
+    {
+        acceptToolBarItems(event);
+    }
+
+    void dragMoveEvent(QDragMoveEvent *event) override
+    {
+        acceptToolBarItems(event);
+    }
+
+    void dropEvent(QDropEvent *event) override
+    {
+        // accepting the move makes the strip remove the dragged item
+        event->setDropAction(Qt::MoveAction);
+        event->accept();
+    }
+
+private:
+    void acceptToolBarItems(QDragMoveEvent *event)
+    {
+        if (event->source() == mStrip) {
+            event->setDropAction(Qt::MoveAction);
+            event->accept();
+        } else {
+            event->ignore();
+        }
+    }
+
+    ToolBarStrip *const mStrip;
+};
+
+QDomElement toolBarElement(const QDomDocument &document, const QString &toolBarName)
+{
+    const QDomNodeList toolBars = document.elementsByTagName(QStringLiteral("ToolBar"));
+    for (int i = 0; i < toolBars.count(); ++i) {
+        const QDomElement element = toolBars.item(i).toElement();
+        if (element.attribute(QStringLiteral("name")) == toolBarName) {
+            return element;
+        }
+    }
+    return {};
+}
+
+QStringList itemNames(const QDomElement &toolBar)
+{
+    QStringList names;
+    for (QDomElement child = toolBar.firstChildElement(); !child.isNull(); child = child.nextSiblingElement()) {
+        if (child.tagName() == QLatin1StringView("Action")) {
+            names << child.attribute(QStringLiteral("name"));
+        } else if (child.tagName() == QLatin1StringView("Separator")) {
+            names << separatorName;
+        }
+    }
+    return names;
+}
+
+QStringList defaultItemNames(KXmlGuiWindow *window, const QString &toolBarName)
+{
+    // the toolbar as shipped, compiled into the application
+    QFile file(QStringLiteral(":/kxmlgui5/%1/%2").arg(window->componentName(), window->xmlFile()));
+    QDomDocument document;
+    if (!file.open(QIODevice::ReadOnly) || !document.setContent(&file)) {
+        return {};
+    }
+    return itemNames(toolBarElement(document, toolBarName));
+}
+
+}
+
+bool Kleo::MacToolBarEditor::edit(KXmlGuiWindow *window, KToolBar *toolBar)
+{
+    KActionCollection *const collection = window->actionCollection();
+    QDomDocument document = window->domDocument();
+    QDomElement toolBarXml = toolBarElement(document, toolBar->objectName());
+    if (toolBarXml.isNull()) {
+        return false;
+    }
+    const QStringList currentNames = itemNames(toolBarXml);
+
+    QDialog sheet(window);
+    sheet.setWindowFlag(Qt::Sheet);
+    sheet.setWindowModality(Qt::WindowModal); // exec() would make it application modal, which is no sheet
+    auto layout = new QVBoxLayout(&sheet);
+    auto title = new QLabel(i18nc("@info", "Drag your favorite items into the toolbar…"), &sheet);
+    layout->addWidget(title);
+    auto strip = new ToolBarStrip(&sheet);
+    layout->addWidget(strip);
+    layout->addWidget(new QLabel(i18nc("@info", "Drag items back here to remove them from the toolbar."), &sheet));
+    auto palette = new Palette(&sheet, strip);
+    palette->setMinimumSize(560, 260);
+    layout->addWidget(palette, 1);
+
+    const auto fillStrip = [strip, collection](const QStringList &names) {
+        strip->clear();
+        for (const QString &name : names) {
+            if (QListWidgetItem *item = createItem(name, collection)) {
+                strip->addItem(item);
+            }
+        }
+    };
+    fillStrip(currentNames);
+
+    // every action with an icon is a candidate, as in KEditToolBar, plus a space
+    palette->addItem(createItem(separatorName, collection));
+    QList<QAction *> candidates = collection->actions();
+    std::sort(candidates.begin(), candidates.end(), [](const QAction *a, const QAction *b) {
+        return plainText(a->text()).localeAwareCompare(plainText(b->text())) < 0;
+    });
+    for (const QAction *action : std::as_const(candidates)) {
+        if (!action->icon().isNull() && !action->text().isEmpty() && !action->menu() && action->isVisible()) {
+            palette->addItem(createItem(action->objectName(), collection));
+        }
+    }
+
+    auto bottom = new QHBoxLayout;
+    bottom->addWidget(new QLabel(i18nc("@label:listbox toolbar style", "Show:"), &sheet));
+    auto show = new QComboBox(&sheet);
+    show->addItem(i18nc("@item:inlistbox toolbar style", "Icon and Text"), int(Qt::ToolButtonTextUnderIcon));
+    show->addItem(i18nc("@item:inlistbox toolbar style", "Icon Only"), int(Qt::ToolButtonIconOnly));
+    show->addItem(i18nc("@item:inlistbox toolbar style", "Text Only"), int(Qt::ToolButtonTextOnly));
+    show->setCurrentIndex(std::max(0, show->findData(int(toolBar->toolButtonStyle()))));
+    bottom->addWidget(show);
+    bottom->addStretch();
+    auto buttons = new QDialogButtonBox(&sheet);
+    QPushButton *defaults = buttons->addButton(i18nc("@action:button", "Use Default Set"), QDialogButtonBox::ResetRole);
+    QPushButton *done = buttons->addButton(i18nc("@action:button", "Done"), QDialogButtonBox::AcceptRole);
+    done->setDefault(true);
+    bottom->addWidget(buttons);
+    layout->addLayout(bottom);
+    QObject::connect(defaults, &QPushButton::clicked, &sheet, [&]() {
+        fillStrip(defaultItemNames(window, toolBar->objectName()));
+    });
+    QObject::connect(buttons, &QDialogButtonBox::accepted, &sheet, &QDialog::accept);
+
+    if (sheet.exec() != QDialog::Accepted) {
+        return false;
+    }
+
+    toolBar->setToolButtonStyle(static_cast<Qt::ToolButtonStyle>(show->currentData().toInt()));
+
+    QStringList newNames;
+    for (int row = 0; row < strip->count(); ++row) {
+        newNames << strip->item(row)->data(Qt::UserRole).toString();
+    }
+    if (newNames == currentNames) {
+        return false;
+    }
+    // replace the toolbar's items in the XML and save it as the local GUI file, like KEditToolBar
+    for (QDomElement child = toolBarXml.firstChildElement(); !child.isNull();) {
+        const QDomElement next = child.nextSiblingElement();
+        if (child.tagName() == QLatin1StringView("Action") || child.tagName() == QLatin1StringView("Separator")) {
+            toolBarXml.removeChild(child);
+        }
+        child = next;
+    }
+    for (const QString &name : std::as_const(newNames)) {
+        QDomElement element = document.createElement(name == separatorName ? QStringLiteral("Separator") : QStringLiteral("Action"));
+        if (name != separatorName) {
+            element.setAttribute(QStringLiteral("name"), name);
+        }
+        toolBarXml.appendChild(element);
+    }
+    // the document includes the merged standard menus; as KEditToolBar does, keep them from
+    // being merged a second time when the local file is loaded
+    const QDomNodeList menus = document.elementsByTagName(QStringLiteral("Menu"));
+    for (int i = 0; i < menus.count(); ++i) {
+        menus.item(i).toElement().setAttribute(QStringLiteral("noMerge"), QStringLiteral("1"));
+    }
+    KXMLGUIFactory::saveConfigFile(document, window->localXMLFile());
+    // rebuilds the GUI from the XML files, the local one included (as KEditToolBar does)
+    window->createGUI(window->xmlFile());
+    return true;
+}

+namespace Kleo::MacNativeMenus
+{
+// Shows popup menus (context menus, button menus) as native NSMenus instead of Qt-drawn ones.
+// The QMenu still runs as usual, invisibly, and receives the item chosen in the native menu,
+// so QMenu::exec() and the triggered() signals behave unchanged.
